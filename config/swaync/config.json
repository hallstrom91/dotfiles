{
	"$schema": "/etc/xdg/swaync/configSchema.json",
	"ignore-gtk-theme": false,
	"positionX": "center",
	"positionY": "top",
	"layer": "overlay",
	"control-center-layer": "overlay",
	"layer-shell": true,
	"layer-shell-cover-screen": false,
	"cssPriority": "user",
	"control-center-margin-top": 10,
	"control-center-margin-bottom": 250,
	"control-center-margin-right": 0,
	"control-center-margin-left": 0,
	"notification-2fa-action": true,
	"notification-inline-replies": false,
	"notification-body-image-height": 100,
	"notification-body-image-width": 200,
	"timeout": 8,
	"timeout-low": 4,
	"timeout-critical": 0,
	"fit-to-screen": true,
	"relative-timestamps": true,
	"control-center-width": 600,
	"control-center-height": 500,
	"notification-window-width": 400,
	"keyboard-shortcuts": true,
	"notification-grouping": true,
	"image-visibility": "when-available",
	"transition-time": 200,
	"hide-on-clear": false,
	"hide-on-action": true,
	"text-empty": "No Notifications",
	"script-fail-notify": true,
	"notification-visibility": {
		"spotify-low": {
			"state": "muted",
			"urgency": "Low",
			"app-name": "Spotify"
		},
		"discord-low": {
			"state": "muted",
			"urgency": "Low",
			"app-name": "Discord"
		},
		"steam-low": {
			"state": "muted",
			"urgency": "Low",
			"app-name": "Steam"
		}
	},
	"widgets": [
		"dnd",
		"label",
		"buttons-grid",
		"mpris",
		"inhibitors",
		"title",
		"notifications"
	],
	"widget-config": {
		"title": {
			"text": "Notifications",
			"clear-all-button": true,
			"button-text": "Clear"
		},
		"notifications": {
			"vexpand": false
		},
		"inhibitors": {
			"text": "Inhibitors",
			"clear-all-button": true,
			"button-text": "Clear All"
		},
		"dnd": {
			"text": "Do Not Disturb"
		},
		"mpris": {
			"autohide": false,
			"show-album-art": "when-available",
			"loop-carousel": false
		},
		"label": {
			"text": "System",
			"max-lines": 5
		},
		"buttons-grid": {
			"buttons-per-row": 2,
			"actions": [
				{
					"label": "",
					"type": "toggle",
					"active": true,
					"command": "sh -c '[[ $SWAYNC_TOGGLE_STATE == true ]] && nmcli radio wifi on || nmcli radio wifi off'",
					"update-command": "sh -c '[[ $(nmcli radio wifi) == \"enabled\" ]] && echo true || echo false'"
				},
				{
					"label": "",
					"type": "normal",
					"command": "",
					"update-command": ""
				},
				{
					"label": "󰜉",
					"type": "normal",
					"command": ""
				},
				{
					"label": "",
					"type": "normal",
					"command": ""
				}
			]
		}
	}
}
