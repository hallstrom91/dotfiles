{
	// NETWORK
	"network": {
		"format": "{ifname}",
		"format-ethernet": "󰱔", // nf-md-check_network_outline
		"format-disconnected": "󰱟", //nf-md-close_network_outline
		"format-wifi": "󰀂 ({signalStrength}%)",
		"tooltip": true,
		"tooltip-format": "{ifname}\nIP: {ipaddr}\nGW: {gwaddr}\nSSID: {essid}\nSignal: {signalStrength}%",
		"on-click": "nm-connection-editor"
		// "on-click": "nm-connection-editor"
		// "on-click-right": "nm-applet",
	},
	"bluetooth": {
		"format": "",
		"format-disabled": "",
		"format-connected": " {num_connections}",
		"tooltip-format": "{controller_alias}\t{controller_address}",
		"tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{device_enumerate}",
		"tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
		"on-click": "blueman-manager"
		// "on-click-right": "bluetoothctl power toggle" // fix
	},
	// SCRN-BRIGHTNESS
	"custom/brightness": {
		"exec": "~/.config/hypr/scripts/brightness.sh --print",
		"format": "{alt} {text}",
		"interval": 10,
		"tooltip": true,
		"return-type": "json",
		"on-click": "~/.config/hypr/scripts/brightness.sh --wofi"
	},
	"custom/nightlight": {
		"exec": "~/.config/hypr/scripts/nightlight.sh --print",
		"format": "{}",
		"interval": 10,
		"tooltip": true,
		"return-type": "json",
		"on-click": "~/.config/hypr/scripts/nightlight.sh --wofi"
	},
	// AUDIO
	"pulseaudio": {
		"format": "{icon} {volume}%",
		"format-muted": "󰎊",
		"format-bluetooth": "󰗾 {volume}%",
		"format-icons": {
			"headphone": "", // nf-fa-headset
			"default": [
				"󰎇", // nf-md-music_note
				"󰷞" // nf-md-music_note_plus
				// "󰎊 " // nf-md-music_note_off
				// "", // nf-fa-volume_off
				// " " // nf-fa-volume_up
			]
		},
		"scroll-step": 5,
		"on-click": "pavucontrol",
		"on-click-right": "pactl set-sink-mute @DEFAULT_SINK@ toggle", // mute toggle!
		"ignored-sinks": [
			"Easy Effects Sink"
		]
	},
	// POWER MENU / SETTINGS
	"custom/powermenu": {
		"exec": "~/.config/hypr/scripts/powermenu.sh --print",
		"format": "{}",
		"interval": "once",
		"tooltip": true,
		"return-type": "json",
		"on-click": "~/.config/hypr/scripts/powermenu.sh --wofi"
	}
}
