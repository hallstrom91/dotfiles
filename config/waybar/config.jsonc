{
	"style": [
		"~/.config/waybar/style.css"
	],
	"include": [
		"~/.config/waybar/modules.jsonc"
		// "~/.config/waybar/modules_extra.jsonc"
	],
	"layer": "top",
	"position": "top",
	// Module placement
	"modules-left": [
		"custom/launcher",
		"hyprland/workspaces",
		"disk",
		"memory",
		"cpu",
		"temperature"
	],
	"modules-center": [
		"clock",
		"power-profiles-daemon"
	],
	"modules-right": [
		"wlr/taskbar",
		"network",
		"bluetooth",
		"pulseaudio",
		"custom/power"
	]
}
