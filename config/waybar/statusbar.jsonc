{
	// DISK(S) ROOT/OS
	"disk#root": {
		"format": " {percentage_free}%",
		"tooltip": true,
		"tooltip-format": "Disk: {path}\nUsed: {specific_used:0.1f} GB\nFree: {specific_free} GB",
		"path": "/",
		"unit": "GB"
	},
	// NVME0
	"disk#nvme0": {
		"format": " {percentage_free}%",
		"tooltip": true,
		"tooltip-format": "Disk: {path}\nUsed: {specific_used:0.1f} GB\nFree: {specific_free} GB",
		// "path": "/",
		"unit": "GB"
	},
	// NVME1
	"disk#nvme1": {
		"format": " {percentage_free}%",
		"tooltip": true,
		"tooltip-format": "Disk: {path}\nUsed: {specific_used:0.1f} GB\nFree: {specific_free} GB",
		// "path": "/",
		"unit": "GB"
	},
	// NVME2
	"disk#nvme2": {
		"format": " {percentage_free}%",
		"tooltip": true,
		"tooltip-format": "Disk: {path}\nUsed: {specific_used:0.1f} GB\nFree: {specific_free} GB",
		// "path": "/",
		"unit": "GB"
	},
	// TEMP NVME0
	"temperature#nvme0": {
		"hwmon-path-abs": "/sys/devices/pci0000:00/0000:00:06.0/0000:02:00.0/nvme/nvme0/hwmon/",
		"input-filename": "temp1_input",
		"format": "{temperatureC}°C",
		"format-critical": "{temperatureC}°C"
		// "tooltip": true,
		// "tooltip-format": "CPU Temp: {temperatureC}°C"
	},
	// TEMP NVME1
	"temperature#nvme1": {
		"hwmon-path-abs": "/sys/devices/pci0000:00/0000:00:1a.0/0000:03:00.0/nvme/nvme1/hwmon",
		"input-filename": "temp1_input",
		"format": "{temperatureC}°C",
		"format-critical": "{temperatureC}°C"
		// "tooltip": true,
		// "tooltip-format": "CPU Temp: {temperatureC}°C"
	},
	// TEMP NVME2
	"temperature#nvme2": {
		"hwmon-path-abs": "/sys/devices/pci0000:00/0000:00:1d.0/0000:06:00.0/nvme/nvme2/hwmon",
		"input-filename": "temp1_input",
		"format": "{temperatureC}°C",
		"format-critical": "{temperatureC}°C"
		// "tooltip": true,
		// "tooltip-format": "CPU Temp: {temperatureC}°C"
	},
	// SYSD FAILED UNITS
	"systemd-failed-units": {
		"hide-on-ok": false, // Do not hide if there is zero failed units.
		"format": "✗ sys:{nr_failed_system} usr:{nr_failed_user}",
		"format-ok": " {overall_state}",
		"system": true, // Monitor failed systemwide units.
		"user": true // Ignore failed user units.
	},
	"memory": {
		"format": "  {used}/{total} GB",
		"tooltip": true,
		"tooltip-format": "RAM Usage: {used} / {total} ({percentage}%)"
	},
	// HYPR WORKSPACES
	"hyprland/workspaces#dp1": {
		"format": "{icon} {id}", // {windows}
		"format-icons": {
			"default": "",
			"active": "",
			// "empty": "",
			// "persistent": ""
			"special": ""
			// "urgent": ""
		},
		"disable-scroll": true,
		"active-only": true,
		"all-outputs": false, // default | true = show all ws-groups
		"show-special": true,
		"special-visible-only": true,
		"workspace-taskbar": {
			"enable": false,
			"update-active-window": true,
			"format": "{icon} {title}"
		},
	},
	// HYPR SUBMAP (ONLY IF ACTIVE)
"hyprland/submap#dp1": {
		"format": " {}",
		"max-length": 20,
		"tooltip": false
	},
	"custom/pacman": {
		"exec-if": "which checkupdates",
		"exec": "~/.config/hypr/scripts/pacman-update.sh",
		"return-type": "json",
		"interval": "once",
		// "interval": 600,
	}
}
