# BAT-alias function (adaptable)
alias bat &>/dev/null && unalias bat 2>/dev/null #clear alias before setting new
if command -v bat >/dev/null 2>&1; then
	alias bat="bat"
elif command -v batcat >/dev/null 2>&1; then
	alias bat="batcat"
else
	alias bat="cat"
fi

# Bat helper
BAT() { bat --paging=never --style=plain "$@"; }

# Extract function (compressed archives)
extract() {
	if [ $# -eq 0 ]; then
		echo "Usage: extract <archive-file>" >&2
		return 2
	fi

	local file=$1
	if [ ! -f "$file" ]; then
		echo "fail: '$file' is not a valid archive to unpack"
		return 1
	fi

	case "$file" in
	*.tar.gz | *.tgz) tar xvzf -- "$file" ;;
	*.tar.bz2 | *.tbz2) tar xvjf -- "$file" ;;
	*.tar.xz) tar xvJf -- "$file" ;;
	*.tar) tar xvf -- "$file" ;;
	*.zip) unzip -- "$file" ;;
	*.rar) unrar x -- "$file" ;;
	*.7z) 7z x -- "$file" ;;
	*)
		echo "extract: '$file' - format not supported" >&2
		return 3
		;;
	esac
}

# reloadapps: reload desktop shortcuts
reloadapps() {
	local dir
	dir="$HOME/.local/share/applications"

	if ! command -v update-desktop-database >/dev/null 2>&1; then
		printf 'fail: update-desktop-database not found\n' >&2
		return 127
	fi

	if update-desktop-database "$dir" >/dev/null 2>&1; then
		printf 'done: refreshed %s\n' "$dir"
		return 0 # success
	else
		local rc=$?
		printf 'fail(%d): %s\n' "$rc" "$dir" >&2
		return "$rc"
	fi
}

## DEV
# dotrun: Run .NET application
dotrun() {
	local p
	p="${1:-Main}"
	shift || true
	command -v dotnet >/dev/null 2>&1 || {
		echo "fail: dotnet not found" >&2
		return 127
	}
	dotnet run --project "$p" "$@"
}

# dotsecrets: list .NET project secrets
dotsecrets() {
	local p
	p="${1:-Main}"
	command -v dotnet >/dev/null 2>&1 || {
		echo "fail: dotnet not found" >&2
		return 127
	}
	dotnet user-secrets list --project "$p" | BAT
}

# vim: prefer nvim, fallback vim or nano
vim() {
	if command -v nvim >/dev/null 2>&1; then
		command nvim "$@"
	else
		command vim "$@" # not installed ? run nano ?
	fi
}

## SYS
# aliaslist:
aliaslist() {
	local f
	f="$HOME/.bash/bash_aliases"
	[[ -r "$f" ]] || {
		echo "fail: no $f" >&2
		return 1
	}
	BAT "$f"
}

