# ---- ENV ---- #
: "${TERM:=xterm-256color}"

export NVM_DIR="$HOME/.nvm"

# gpg, pass, gcm; pinentry
GPG_TTY="$(tty)"
tty -s && export GPG_TTY

command -v nvim >/dev/null 2>&1 && export EDITOR=nvim        # or vi|nano|code
command -v qtchooser >/dev/null 2>&1 && export QT_SELECT=qt5 # or qt6
# command -v git-credential-manager >/dev/null 2>&1 && export GCM_CREDENTIAL_STORE=gpg
export GCM_CREDENTIAL_STORE=gpg
